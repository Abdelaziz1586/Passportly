# ===================================
# Travel Planning and Booking Platform
# Environment Variables Template
# ===================================

# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# MongoDB Atlas (Shared Team Database)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbName>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/travel_platform?retryWrites=true&w=majority

# Authentication (JWT via httpOnly Cookies)
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=1d
COOKIE_NAME=access_token
COOKIE_SECURE=false

# Seeded Default Admin Account (for initial DB bootstrap)
SEED_ADMIN_EMAIL=admin@travelplatform.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Stripe (Test Mode)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# FXRatesAPI (Currency Conversion)
FXRATES_API_BASE_URL=https://api.fxratesapi.com
FXRATES_API_KEY=replace_me

# Media Uploads
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_BYTES=5242880

# Flight seat hold length in minutes (FLT-22). Requirements sheet: 10, fixed from hold creation, never extended.
FLIGHT_HOLD_MINUTES=10

# Mail / SMTP Server (Generic SMTP — non-Google supported, e.g., Mailtrap, Brevo, Resend, Postmark, custom SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_me
SMTP_PASS=replace_me
MAIL_FROM=Passportly <no-reply@passportly.local>
APP_BASE_URL=http://localhost:3000
